{
  "manifest_version": 3,
  "name": "ReviewPort for TikTok Shop",
  "version": "5.4.0",
  "description": "Scan TikTok Shop reviews locally with Pause, Stop and up to 100 pages, then use Review Studio for clear 5-point ratings and local CSV, Markdown or Shopify review-app exports.",
  "permissions": [
    "scripting",
    "activeTab",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://shop.tiktok.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Open ReviewPort"
  },
  "content_scripts": [
    {
      "matches": ["https://shop.tiktok.com/*"],
      "js": ["js/content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["js/interceptor.js"],
      "matches": ["https://shop.tiktok.com/*"]
    }
  ],
  "background": {
    "service_worker": "js/background.js"
  },
  "icons": {
    "16": "images/icon-16.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  }
}
